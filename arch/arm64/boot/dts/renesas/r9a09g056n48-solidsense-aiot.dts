/dts-v1/;

#include "rzv2n-sr-som.dtsi"
#include <dt-bindings/leds/common.h>

/ {
	model = "Solidrun RZ/V2N Solidsense AIOT";
	compatible = "solidrun,rzv2n-sr-som", "renesas,r9a09g056n48", "renesas,r9a09g056";

	aliases {
		i2c3 = &i2c_csi0;
		i2c4 = &i2c_csi1;
	};

	leds {
		compatible = "gpio-leds";

		CPU_LED_D10 {
			label = "CPU_LED_D10";
			gpios = <&pinctrl RZG2L_GPIO(8, 5) GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};
	
	v_1_2: regulator-1-2 {
		compatible = "regulator-fixed";
		regulator-name = "1v2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
	};

	v_3_3: regulator-3-3 {
		compatible = "regulator-fixed";
		regulator-name = "3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	v_5_0: regulator-5-0 {
		compatible = "regulator-fixed";
		regulator-name = "5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vmmc: regulator-mmc {
		compatible = "regulator-fixed";
		regulator-name = "vmmc";
		vin-supply = <&v_3_3>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&pinctrl RZG2L_GPIO(10, 3) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	/*
	 * LTE modem (Sequans GC02S1) power/reset via rfkill-gpio. Needs the
	 * of_match_table backport in net/rfkill/rfkill-gpio.c (mainline 6.1 is
	 * ACPI-only). Mutually exclusive with the gpio-hog fallback below.
	 *   shutdown-gpios = P62 (CELL_VBAT enable): unblocked -> HIGH -> powered.
	 *   reset-gpios    = P42 (RESETN, active-low): driver drives logic-1 when
	 *                    unblocked, so declared ACTIVE_HIGH -> out of reset.
	 */
	rfkill_lte: rfkill-lte {
		compatible = "rfkill-gpio";
		label = "lte";
		radio-type = "wwan";
		shutdown-gpios = <&pinctrl RZG2L_GPIO(6, 2) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZG2L_GPIO(4, 2) GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	sensor_clk: sensor_clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
    };
};

/*
 * Fallback: LTE power/reset via gpio-hogs for the stock (ACPI-only)
 * rfkill-gpio driver. Disabled - the rfkill_lte node owns P42/P62. To use,
 * enable here (#if 1) and disable the rfkill_lte node; don't claim twice.
 */
&pinctrl {
	pinctrl-names = "default";

#if 0
	lte_rst_hog: lte-reset-hog {
		gpio-hog;
		/* LTE_RST: J7[43] — pin P42; active-low + output-low => physical HIGH => out of reset */
		gpios = <RZG2L_GPIO(4, 2) GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "lte-reset";
	};

	lte_pwr_hog: lte-power-hog {
		gpio-hog;
		/* LTE_PWR / CELL_VBAT enable: J7[14] — pin P62 => HIGH => modem powered */
		gpios = <RZG2L_GPIO(6, 2) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lte-power";
	};
#endif
};

/*
 * USB2 on a 3-wire header (D+/D-/GND), host-only (disk adapter).
 * For OTG: set dr_mode="otg" on ehci0/ohci0 + enable hsusb (see EVK).
 */
&ehci0 {
	spurious-oc;
	status = "okay";
};

&ohci0 {
	spurious-oc;
	status = "okay";
};

&usb2_phy0 {
	/* Needed only in OTG mode (PHY requests "vbus" exclusively); harmless for host. */
	//vbus-supply = <&v_5_0>;
	status = "okay";
};

&eth0 {
	status = "disabled";
};

&eth1 {
	status = "disabled";
};

/* UARTA (UART2) */
&sci2 {
	status = "disabled";
};

/* UARTB (UART3) */
&sci3 {
	status = "disabled";
};

/* Carrier I2C2 */
&i2c1 {
	status = "okay";

	/*
	 * I2C devices on carrier board:
	 * - STM32U031C8U6 MCU at 0x18
	 * - TAC5111IRGER Audio Codec at 0x50
	 * - TCA9546APWR I2C Switch at 0x70
	 * Flash Card (J6):
	 * - LM3645YCGR Camera Flash at 0x65
	 * - OPT4001DTSR Ambient Light Sensor at 0x44
	 * - HDC3022DEJR Humidity/Temperature sensor at 0x46
	 */
	i2c-switch@70 {
		compatible = "nxp,pca9546";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;
		reset-gpios = <&pinctrl RZG2L_GPIO(7, 4) GPIO_ACTIVE_LOW>;

		i2c_csi0: i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
		};

		i2c_csi1: i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
		};
	};

	/* Audio codec - currently disabled pending driver verification */
	codec: audio-codec@50 {
		compatible = "ti,tac5111";
		reg = <0x50>;
		status = "disabled";
		
		#sound-dai-cells = <0>;
		
		pinctrl-names = "default";
		//pinctrl-0 = <&pinctrl_codec>;
		
		interrupts-extended = <&pinctrl RZG2L_GPIO(7, 1) IRQ_TYPE_EDGE_FALLING>;
		
		avdd-supply = <&v_3_3>;
		iovdd-supply = <&v_3_3>;

		/*
		 * GPIO configuration:
		 * - GPIO1: PDM data input
		 * - GPIO2: PDM clock output
		 * - GPO1:  Chip IRQ output
		 */
		ti,gpios-func = <1>, <4>, <3>;

		/*
		 * PDM input pin selection:
		 * - Channels 0/1: GPIO1
		 * - Channels 2/3: Not used
		 */
		ti,pdm-input-pins = <1>, <0>;

		/* GPI1 configured as CCLK input */
		ti,gpi1-func = <2>;

		/*
		 * VREF and MICBIAS configuration (required by driver)
		 * Note: These are not used by this board but must be
		 * configured to avoid probe errors
		 */
		ti,vref = <0>;
		ti,micbias-vg = <3>;

		/*
		 * GPIO drive configuration:
		 * - GPIO1: Floating (output buffer disabled)
		 * - GPIO2: Push-pull for PDM clock
		 * - GPO1:  Open-drain for IRQ
		 */
		ti,gpios-drive = <0>, <1>, <3>;

		/* GPA configuration */
		ti,gpa-gpio = <0>;
		ti,gpa-threshold = <75>, <186>;
	};

	carrier_eeprom: at24c02@57 {
		compatible = "atmel,24c02";
		reg = <0x57>;
	};
};
