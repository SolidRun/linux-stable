/dts-v1/;

#include "rzv2n-sr-som.dtsi"
#include <dt-bindings/leds/common.h>

/ {
	model = "Solidrun RZ/V2N Solidsense AIOT";
	compatible = "solidrun,rzv2n-solidsense-aiot", "solidrun,rzv2n-sr-som",
		     "renesas,r9a09g056n48", "renesas,r9a09g056";

	aliases {
		i2c3 = &i2c_csi0;
		i2c4 = &i2c_csi1;
		rtc0 = &mcu_sc;
		rtc1 = &pmic_rtc;
	};

	leds {
		compatible = "gpio-leds";

		CPU_LED_D10 {
			label = "CPU_LED_D10";
			gpios = <&pinctrl RZG2L_GPIO(8, 5) GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};
	
	v_1_2: regulator-1-2 {
		compatible = "regulator-fixed";
		regulator-name = "1v2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
	};

	/* 1.8V carrier rail; &v_1_8 is referenced by the Flash Card overlay. */
	v_1_8: regulator-1-8 {
		compatible = "regulator-fixed";
		regulator-name = "1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	v_3_3: regulator-3-3 {
		compatible = "regulator-fixed";
		regulator-name = "3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	v_5_0: regulator-5-0 {
		compatible = "regulator-fixed";
		regulator-name = "5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vmmc: regulator-mmc {
		compatible = "regulator-fixed";
		regulator-name = "vmmc";
		vin-supply = <&v_3_3>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&pinctrl RZG2L_GPIO(10, 3) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	/*
	 * LTE modem (Sequans GC02S1) power/reset via rfkill-gpio. Needs the
	 * of_match_table backport in net/rfkill/rfkill-gpio.c (mainline 6.1 is
	 * ACPI-only). Mutually exclusive with the gpio-hog fallback below.
	 *   shutdown-gpios = P62 (CELL_VBAT enable): unblocked -> HIGH -> powered.
	 *   reset-gpios    = P42 (RESETN, active-low): driver drives logic-1 when
	 *                    unblocked, so declared ACTIVE_HIGH -> out of reset.
	 */
	rfkill_lte: rfkill-lte {
		compatible = "rfkill-gpio";
		label = "lte";
		radio-type = "wwan";
		shutdown-gpios = <&pinctrl RZG2L_GPIO(6, 2) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZG2L_GPIO(4, 2) GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	sensor_clk: sensor_clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
    };

	sound_card: sound {
		compatible = "audio-graph-card";
		label = "solidsense-aiot";
		dais = <&rsnd_port>;
	};
};

/*
 * Fallback: LTE power/reset via gpio-hogs for the stock (ACPI-only)
 * rfkill-gpio driver. Disabled - the rfkill_lte node owns P42/P62. To use,
 * enable here (#if 1) and disable the rfkill_lte node; don't claim twice.
 */
&pinctrl {
	pinctrl-names = "default";

	/* Audio (TAC5111 -> PAM8302 -> speaker), routed like the RZ/V2N EVK. */
	sound_clk_pins: sound-clk {
		pinmux = <RZG2L_PORT_PINMUX(1, 0, 7)>, /* AUDIO_CLKB   */
			 <RZG2L_PORT_PINMUX(1, 1, 7)>, /* AUDIO_CLKC   */
			 <RZG2L_PORT_PINMUX(9, 7, 8)>; /* AUDIO_CLKOUT */
	};

	ssi3_ssi4_pins: ssi34 {
		pinmux = <RZG2L_PORT_PINMUX(1, 2, 7)>, /* SSI3_SCK         */
			 <RZG2L_PORT_PINMUX(1, 3, 7)>, /* SSI3_WS          */
			 <RZG2L_PORT_PINMUX(0, 4, 7)>, /* SSI3_SDATA (out) */
			 <RZG2L_PORT_PINMUX(1, 5, 7)>; /* SSI4_SDATA (in)  */
	};

	/* PAM8302 /SD on P0_0 has a 10k pull-down; hog high to enable the amp. */
	audio_amp_en_hog: audio-amp-enable-hog {
		gpio-hog;
		gpios = <RZG2L_GPIO(0, 0) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "audio-amp-enable";
	};

#if 0
	lte_rst_hog: lte-reset-hog {
		gpio-hog;
		/* LTE_RST: J7[43] — pin P42; active-low + output-low => physical HIGH => out of reset */
		gpios = <RZG2L_GPIO(4, 2) GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "lte-reset";
	};

	lte_pwr_hog: lte-power-hog {
		gpio-hog;
		/* LTE_PWR / CELL_VBAT enable: J7[14] — pin P62 => HIGH => modem powered */
		gpios = <RZG2L_GPIO(6, 2) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lte-power";
	};
#endif

	mcu_irq_pin: mcu-irq {
		pins = "P56";
		bias-pull-up;
	};
};

/*
 * USB2 on a 3-wire header (D+/D-/GND), host-only (disk adapter).
 * For OTG: set dr_mode="otg" on ehci0/ohci0 + enable hsusb (see EVK).
 */
&ehci0 {
	spurious-oc;
	status = "okay";
};

&ohci0 {
	spurious-oc;
	status = "okay";
};

&usb2_phy0 {
	/* Needed only in OTG mode (PHY requests "vbus" exclusively); harmless for host. */
	//vbus-supply = <&v_5_0>;
	status = "okay";
};

&eth0 {
	status = "disabled";
};

&eth1 {
	status = "disabled";
};

/* UARTA (UART2) */
&sci2 {
	status = "disabled";
};

/* UARTB (UART3) */
&sci3 {
	status = "disabled";
};

&pcie0 {
	status = "disabled";
};

/* Carrier I2C2 */
&i2c1 {
	status = "okay";

	/*
	 * I2C devices on carrier board:
	 * - STM32U031C8U6 MCU at 0x18
	 * - TAC5111IRGER Audio Codec at 0x50
	 * - TCA9546APWR I2C Switch at 0x70
	 * Flash Card (J6):
	 * - LM3645YCGR Camera Flash at 0x65
	 * - OPT4001DTSR Ambient Light Sensor at 0x44
	 * - HDC3022DEJR Humidity/Temperature sensor at 0x46
	 */
	mcu_sc: system-controller@18 {
		compatible = "solidrun,solidsense-aiot-system-controller";
		reg = <0x18>;
		pinctrl-names = "default";
		pinctrl-0 = <&mcu_irq_pin>;
		interrupts-extended = <&pinctrl RZG2L_GPIO(5, 6) IRQ_TYPE_LEVEL_LOW>;
		system-power-controller;
	};

	i2c-switch@70 {
		compatible = "nxp,pca9546";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;
		reset-gpios = <&pinctrl RZG2L_GPIO(7, 4) GPIO_ACTIVE_LOW>;

		i2c_csi0: i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
		};

		i2c_csi1: i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
		};
	};

	/*
	 * TAC5111 codec, playback-only (OUT1 -> PAM8302). Clock consumer:
	 * CCLK arrives on GPI1 from the SoC AUDIO_CLKOUT.
	 */
	codec: audio-codec@50 {
		compatible = "ti,tac5111";
		reg = <0x50>;
		status = "okay";
		
		#sound-dai-cells = <0>;
		
		pinctrl-names = "default";
		//pinctrl-0 = <&pinctrl_codec>;
		
		interrupts-extended = <&pinctrl RZG2L_GPIO(7, 1) IRQ_TYPE_EDGE_FALLING>;
		
		avdd-supply = <&v_3_3>;
		iovdd-supply = <&v_3_3>;

		/*
		 * GPIO configuration:
		 * - GPIO1: PDM data input
		 * - GPIO2: PDM clock output
		 * - GPO1:  Chip IRQ output
		 */
		ti,gpios-func = <1>, <4>, <3>;

		/*
		 * PDM input pin selection:
		 * - Channels 0/1: GPIO1
		 * - Channels 2/3: Not used
		 */
		ti,pdm-input-pins = <1>, <0>;

		/* GPI1 configured as CCLK input */
		ti,gpi1-func = <2>;

		/*
		 * VREF and MICBIAS configuration (required by driver)
		 * Note: These are not used by this board but must be
		 * configured to avoid probe errors
		 */
		ti,vref = <0>;
		ti,micbias-vg = <3>;

		/*
		 * GPIO drive configuration:
		 * - GPIO1: Floating (output buffer disabled)
		 * - GPIO2: Push-pull for PDM clock
		 * - GPO1:  Open-drain for IRQ
		 */
		ti,gpios-drive = <0>, <1>, <3>;

		/* GPA configuration */
		ti,gpa-gpio = <0>;
		ti,gpa-threshold = <75>, <186>;

		/* Digital audio link to the SoC SSI3/SSI4 (see &rcar_sound) */
		port {
			tac5111_endpoint: endpoint {
				remote-endpoint = <&rsnd_endpoint>;
			};
		};
	};

	carrier_eeprom: at24c02@57 {
		compatible = "atmel,24c02";
		reg = <0x57>;
	};
};

/*
 * Sound block: SSI3 playback, SSI4 capture (shares SSI3 SCK/WS). SoC is
 * bit-clock/frame master; AUDIO_CLKOUT clocks the codec. Mirrors the EVK.
 */
&rcar_sound {
	pinctrl-0 = <&sound_clk_pins>, <&ssi3_ssi4_pins>;
	pinctrl-names = "default";

	status = "okay";

	/* audio_clkout */
	#clock-cells = <0>;
	clock-frequency = <11289600>;

	#sound-dai-cells = <1>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		rsnd_port: port@0 {
			reg = <0>;
			rsnd_endpoint: endpoint {
				remote-endpoint = <&tac5111_endpoint>;

				dai-format = "i2s";
				bitclock-master = <&rsnd_endpoint>;
				frame-master = <&rsnd_endpoint>;
				mclk-fs = <256>;

				playback = <&ssi3>, <&src0>, <&dvc0>;
				capture = <&ssi4>, <&src1>, <&dvc1>;
			};
		};
	};
};

/*
 * On-SoM versa3 audio master clocks (22.5792 MHz = 44.1k, 24.576 MHz = 48k).
 * The SoC dtsi leaves these at 0 Hz; the board must set them or the SSI
 * CLK_ON poll times out (-110) and playback/capture fail.
 */
&audio_clka {
	clock-frequency = <22579200>;
};

&audio_clkb {
	clock-frequency = <24576000>;
};

&audio_clkc {
	clock-frequency = <22579200>;
};
