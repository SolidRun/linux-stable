/dts-v1/;

/* Switch selection settings */
#define SEL_CAN01_HEADER		1
#define SEL_SCI4_CAN01			0

/* Mode selection settings */
/*
 * Enable eMMC or uSD on SDHI channel 0 from CN15 connector.
 * CN15_eMMC_uSD:
 * - eMMC	0 (default)
 * - uSD	1
 */
#define CN15_eMMC_uSD		0

#include "rzv2h-evk-common.dtsi"

/ {
	model = "Renesas RZ/V2H EVK Board Ver 2 based on r9a09g057h44";
	compatible = "renesas,rzv2h-evk-ver2", "renesas,r9a09g057h44", "renesas,r9a09g057";
};

#if (CN15_eMMC_uSD)
#include "rzv2-evk-cn15-sd.dtsi"
#else
#include "rzv2-evk-cn15-emmc.dtsi"
#endif
