		tsu0: thermal@11000000 {
			compatible = "renesas,r9a09g047-tsu";
			reg = <0 0x11000000 0 0x1000>;
			interrupts = <GIC_SPI 248 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "adi", "adcmpi";
			clocks = <&cpg CPG_MOD 0x109>;
			resets = <&cpg 0xf7>;
			power-domains = <&cpg>;
			#thermal-sensor-cells = <0>;
			renesas,tsu-trim = <&sys 0x320>;
		};

		tsu1: thermal@14002000 {
			compatible = "renesas,r9a09g047-tsu";
			reg = <0 0x14002000 0 0x1000>;
			interrupts = <GIC_SPI 250 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 251 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "adi", "adcmpi";
			clocks = <&cpg CPG_MOD 0x10a>;
			resets = <&cpg 0xf8>;
			power-domains = <&cpg>;
			#thermal-sensor-cells = <0>;
			renesas,tsu-trim = <&sys 0x330>;
		};

		rcar_sound: sound@13c00000 {
			/*
			 * #sound-dai-cells is required
			 *
			 * Single DAI : #sound-dai-cells = <0>; <&rcar_sound>;
			 * Multi  DAI : #sound-dai-cells = <1>; <&rcar_sound N>;
			 */
			/*
			 * #clock-cells is required for audio_clkout0/1/2/3
			 *
			 * clkout       : #clock-cells = <0>;   <&rcar_sound>;
			 * clkout0/1/2/3: #clock-cells = <1>;   <&rcar_sound N>;
			 */
			compatible =  "renesas,rcar_sound-r9a09g056";
			reg =   <0 0x13c00000 0 0x10000>, /* SCU */
				<0 0x13c20000 0 0x10000>, /* ADG */
				<0 0x13c30000 0 0x1000>,  /* SSIU */
				<0 0x13c31000 0 0x1F000>, /* SSI */
				<0 0x13c50000 0 0x10000>, /* Audio DMAC peri peri */
				<0 0x14402400 0 0x3000>;  /* SPDIF */
			reg-names = "scu", "adg", "ssiu", "ssi", "audmapp", "spdif";
			clocks = <&cpg CPG_MOD 0xf5>,
				 <&cpg CPG_MOD 0x18a>,
				 <&cpg CPG_MOD 0x189>,
				 <&cpg CPG_MOD 0x188>,
				 <&cpg CPG_MOD 0x187>,
				 <&cpg CPG_MOD 0x186>,
				 <&cpg CPG_MOD 0x185>,
				 <&cpg CPG_MOD 0x184>,
				 <&cpg CPG_MOD 0x183>,
				 <&cpg CPG_MOD 0x182>,
				 <&cpg CPG_MOD 0x181>,
				 <&cpg CPG_MOD 0x180>,
				 <&cpg CPG_MOD 0xf6>,
				 <&cpg CPG_MOD 0xf7>,
				 <&cpg CPG_MOD 0x17d>,
				 <&cpg CPG_MOD 0x17c>,
				 <&cpg CPG_MOD 0x17b>,
				 <&cpg CPG_MOD 0x17a>,
				 <&cpg CPG_MOD 0x179>,
				 <&cpg CPG_MOD 0x178>,
				 <&cpg CPG_MOD 0x177>,
				 <&cpg CPG_MOD 0x176>,
				 <&cpg CPG_MOD 0x175>,
				 <&cpg CPG_MOD 0x174>,
				 <&cpg CPG_MOD 0x17e>,
				 <&cpg CPG_MOD 0x173>,
				 <&cpg CPG_MOD 0x172>,
				 <&cpg CPG_MOD 0x173>,
				 <&cpg CPG_MOD 0x172>,
				 <&cpg CPG_MOD 0x170>,
				 <&cpg CPG_MOD 0x171>,
				 <&cpg CPG_MOD 0xf8>,
				 <&cpg CPG_MOD 0xf9>,
				 <&cpg CPG_MOD 0xfb>,
				 <&cpg CPG_MOD 0xfc>,
				 <&cpg CPG_MOD 0xfd>,
				 <&cpg CPG_MOD 0xfa>,
				 <&cpg CPG_MOD 0x169>,
				 <&cpg CPG_MOD 0x168>,
				 <&cpg CPG_MOD 0x167>,
				 <&cpg CPG_MOD 0x166>,
				 <&cpg CPG_MOD 0x165>,
				 <&cpg CPG_MOD 0x164>,
				 <&cpg CPG_MOD 0x163>,
				 <&cpg CPG_MOD 0x162>,
				 <&cpg CPG_MOD 0x161>,
				 <&cpg CPG_MOD 0x160>,
				 <&cpg CPG_MOD 0xfe>,
				 <&cpg CPG_MOD 0xff>,
				 <&cpg CPG_MOD 0x100>,
				 <&cpg CPG_MOD 0x16a>,
				 <&cpg CPG_MOD 0x16b>,
				 <&cpg CPG_MOD 0x16c>;
			clock-names = "ssi-all",
				 "ssi.9", "ssi.8", "ssi.7", "ssi.6",
				 "ssi.5", "ssi.4", "ssi.3", "ssi.2",
				 "ssi.1", "ssi.0",
				 "ssif_supply_clk",
				 "scu_clk", "scu_clkx2",
				 "src.9", "src.8", "src.7", "src.6",
				 "src.5", "src.4", "src.3", "src.2",
				 "src.1", "src.0",
				 "scu_supply_clk",
				 "mix.1", "mix.0",
				 "ctu.1", "ctu.0",
				 "dvc.0", "dvc.1",
				 "audmac-pp",
				 "adg_clk",
				 "clk_a", "clk_b", "clk_c", "clk_i",
				 "adg.ssi.9", "adg.ssi.8", "adg.ssi.7", "adg.ssi.6",
				 "adg.ssi.5", "adg.ssi.4", "adg.ssi.3", "adg.ssi.2",
				 "adg.ssi.1", "adg.ssi.0",
				 "spdif.0", "spdif.1", "spdif.2",
				 "adg.spdif.0", "adg.spdif.1", "adg.spdif.2";
			power-domains = <&cpg>;
			resets = <&cpg 0xe1>,
				 <&cpg 0xeb>,
				 <&cpg 0xea>,
				 <&cpg 0xe9>,
				 <&cpg 0xe8>,
				 <&cpg 0xe7>,
				 <&cpg 0xe6>,
				 <&cpg 0xe5>,
				 <&cpg 0xe4>,
				 <&cpg 0xe3>,
				 <&cpg 0xe2>,
				 <&cpg 0xed>,
				 <&cpg 0xec>,
				 <&cpg 0xee>,
				 <&cpg 0xef>,
				 <&cpg 0xf0>,
				 <&cpg 0xf1>;
			reset-names = "ssi-all",
				 "ssi.9", "ssi.8", "ssi.7", "ssi.6",
				 "ssi.5", "ssi.4", "ssi.3", "ssi.2",
				 "ssi.1", "ssi.0",
				 "audmac-pp", "scu",
				 "adg",
				 "spdif.0", "spdif.1", "spdif.2";
			status = "disabled";

			rcar_sound,ctu {
				ctu00: ctu-0 { };
				ctu01: ctu-1 { };
				ctu02: ctu-2 { };
				ctu03: ctu-3 { };
				ctu10: ctu-4 { };
				ctu11: ctu-5 { };
				ctu12: ctu-6 { };
				ctu13: ctu-7 { };
			};

			rcar_sound,dvc {
				dvc0: dvc-0 {
					dmas = <&dmac1 0x1A1DB3>;
					dma-names = "tx";
				};
				dvc1: dvc-1 {
					dmas = <&dmac1 0x1B1DB4>;
					dma-names = "tx";
				};
			};

			rcar_sound,mix {
				mix0: mix-0 { };
				mix1: mix-1 { };
			};

			rcar_sound,src {
				src0: src-0 {
					interrupts = <GIC_SPI 902 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x061D9F>, <&dmac2 0x101DA9>;
					dma-names = "rx", "tx";
				};
				src1: src-1 {
					interrupts = <GIC_SPI 903 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x071DA0>, <&dmac2 0x111DAA>;
					dma-names = "rx", "tx";
				};
				src2: src-2 {
					interrupts = <GIC_SPI 904 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x081DA1>, <&dmac2 0x121DAB>;
					dma-names = "rx", "tx";
				};
				src3: src-3 {
					interrupts = <GIC_SPI 905 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x091DA2>, <&dmac2 0x131DAC>;
					dma-names = "rx", "tx";
				};
				src4: src-4 {
					interrupts = <GIC_SPI 906 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x0A1DA3>, <&dmac2 0x141DAD>;
					dma-names = "rx", "tx";
				};
				src5: src-5 {
