					dmas = <&dmac1 0x4E1D93>, <&dmac2 0x4F1D94>;
					dma-names = "tx", "rx";
				};
				ssiu92: ssiu-26 {
					dmas = <&dmac1 0x501D95>, <&dmac2 0x511D96>;
					dma-names = "tx", "rx";
				};
				ssiu93: ssiu-27 {
					dmas = <&dmac1 0x521D97>, <&dmac2 0x531D98>;
					dma-names = "tx", "rx";
				};
			};

			rcar_sound,spdif {
				spdif0: spdif-0 {
					interrupts = <GIC_SPI 899 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x011D9A>, <&dmac2 0x001D99>;
					dma-names = "tx", "rx";
				};
				spdif1: spdif-1 {
					interrupts = <GIC_SPI 900 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x031D9C>, <&dmac2 0x021D9B>;
					dma-names = "tx", "rx";
				};
				spdif2: spdif-2 {
					interrupts = <GIC_SPI 901 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x051D9E>, <&dmac2 0x041D9D>;
					dma-names = "tx", "rx";
				};
			};
		};
	};

	thermal-zones {
		emergency {
			polling-delay = <1000>;
			on-temperature = <110000>;
			off-temperature = <95000>;
			target_cpus =   <&cpu1 &cpu2 &cpu3>;
			status = "disabled";
		};

		sensor_thermal0: sensor-thermal0 {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&tsu0 0>;

			trips {
				sensor0_crit: sensor0-crit {
					temperature = <120000>;
					hysteresis = <1000>;
					type = "critical";
				};

			};
		};

		sensor_thermal1: sensor-thermal1 {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&tsu1 0>;

			trips {
				sensor1_crit: sensor1-crit {
					temperature = <120000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts-extended = <&gic GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 12 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "sec-phys", "phys", "virt", "hyp-phys", "hyp-virt";
	};
};
