			compatible = "renesas,r9a09g056-mipi-dsi",
				     "renesas,rzv2n-mipi-dsi";
			reg = <0 0x16430000 0 0x20000>;
			clocks = <&cpg CPG_MOD 0xe8>,
				 <&cpg CPG_MOD 0xe9>,
				 <&cpg CPG_MOD 0xea>,
				 <&cpg CPG_MOD 0xeb>,
				 <&cpg CPG_MOD 0xec>;
			clock-names = "pclk", "aclk",
				      "vclk0", "lpclk", "pllclk";
			resets = <&cpg 0xd7>,
				 <&cpg 0xd8>;
			reset-names = "prst", "arst";
			power-domains = <&cpg>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					dsi0_in: endpoint {
						remote-endpoint = <&du_out_dsi0>;
					};
				};

				port@1 {
					reg = <1>;
					dsi0_out: endpoint {
					};
				};
			};
		};

