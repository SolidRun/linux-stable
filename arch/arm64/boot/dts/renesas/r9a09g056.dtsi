		rcar_sound: sound@13c00000 {
			/*
			 * #sound-dai-cells is required
			 *
			 * Single DAI : #sound-dai-cells = <0>; <&rcar_sound>;
			 * Multi  DAI : #sound-dai-cells = <1>; <&rcar_sound N>;
			 */
			/*
			 * #clock-cells is required for audio_clkout0/1/2/3
			 *
			 * clkout       : #clock-cells = <0>;   <&rcar_sound>;
			 * clkout0/1/2/3: #clock-cells = <1>;   <&rcar_sound N>;
			 */
			compatible =  "renesas,rcar_sound-r9a09g056";
			reg =   <0 0x13c00000 0 0x10000>, /* SCU */
				<0 0x13c20000 0 0x10000>, /* ADG */
				<0 0x13c30000 0 0x1000>,  /* SSIU */
				<0 0x13c31000 0 0x1F000>, /* SSI */
				<0 0x13c50000 0 0x10000>, /* Audio DMAC peri peri */
				<0 0x14402400 0 0x3000>;  /* SPDIF */
			reg-names = "scu", "adg", "ssiu", "ssi", "audmapp", "spdif";
			clocks = <&cpg CPG_MOD 0xf5>,
				 <&cpg CPG_MOD 0x18a>,
				 <&cpg CPG_MOD 0x189>,
				 <&cpg CPG_MOD 0x188>,
				 <&cpg CPG_MOD 0x187>,
				 <&cpg CPG_MOD 0x186>,
				 <&cpg CPG_MOD 0x185>,
				 <&cpg CPG_MOD 0x184>,
				 <&cpg CPG_MOD 0x183>,
