			interrupt-names = "error", "rx", "tx";
			clocks = <&cpg CPG_MOD 0x57>,
				<&cpg CPG_MOD 0x58>,
				<&cpg CPG_MOD 0x59>;
			resets = <&cpg 0x7d>;
			power-domains = <&cpg>;
