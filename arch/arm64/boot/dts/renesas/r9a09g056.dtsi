				 <&cpg CPG_MOD 0x9f>,
				 <&cpg CPG_MOD 0xa0>,
				 <&cpg CPG_MOD 0xa2>,
				 <&cpg CPG_CORE CLK_SMUX2_XSPI_CLK1>,
				 <&cpg CPG_CORE CLK_SMUX2_XSPI_CLK0>,
				 <&cpg CPG_CORE CLK_PLLCM33_XSPI>;
			clock-names = "spi", "hclk", "aclk", "spix2",
