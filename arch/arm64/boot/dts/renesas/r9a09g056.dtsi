				};
			};
		};

		adc0: adc@11c00000 {
			compatible = "renesas,r9a09g057-adc", "renesas,rzv2h-adc";
			reg = <0 0x11C00000 0 0x400>;
			clocks = <&cpg CPG_MOD 0x108>,
