			power-domains = <&cpg>;
			status = "disabled";

			sdhi2_vqmmc: vqmmc-regulator {
				regulator-name = "SDHI2-VQMMC";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				status = "disabled";
			};
		};

		dsi0: dsi@16430000 {
			compatible = "renesas,r9a09g057-mipi-dsi",
				     "renesas,rzv2h-mipi-dsi";
			reg = <0 0x16430000 0 0x20000>;
			clocks = <&cpg CPG_MOD 0xec>,
				 <&cpg CPG_MOD 0xe9>,
				 <&cpg CPG_MOD 0xe8>,
				 <&cpg CPG_MOD 0xea>,
				 <&cpg CPG_MOD 0xeb>;
			clock-names = "pllclk", "aclk",
				      "pclk", "vclk0", "lpclk";
			resets = <&cpg 0xd8>, <&cpg 0xd7>;
			reset-names = "arst", "prst";
			power-domains = <&cpg>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					dsi0_in: endpoint {
						remote-endpoint = <&du_out_dsi0>;
					};
				};

				port@1 {
					reg = <1>;
					dsi0_out: endpoint {
					};
				};
			};
		};

		du: display@16460000 {
			compatible = "renesas,r9a09g057-du";
			reg = <0 0x16460000 0 0x10000>;
			interrupts = <GIC_SPI 882 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD 0xed>,
				 <&cpg CPG_MOD 0xee>,
				 <&cpg CPG_MOD 0xef>;
			clock-names = "aclk0", "pclk0", "vclk0";
			power-domains = <&cpg>;
			resets = <&cpg 0xdc>;
			renesas,vsps = <&vspd 0>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					du_out_dsi0: endpoint {
						remote-endpoint = <&dsi0_in>;
					};
				};
			};
		};

		fcpcs: vcp4@16410000 {
			compatible = "renesas,vcp4-fcpcs";
			reg = <0 0x16410000 0 0x1000>;
			renesas,#ch = <0>;
		};

		vdpb: vcp4@16400000 {
			compatible = "renesas,vcp4-vdpb";
			reg = <0 0x16400000 0 0x1000>,
			      <0 0x16420200 0 0xE00>;
			reg-names = "vlc", "ce";
			interrupts = <GIC_SPI 887 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 888 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD 0xf3>,
				 <&cpg CPG_MOD 0xf4>;
			clock-names = "aclk", "pclk";
			power-domains = <&cpg>;
			resets = <&cpg 0xe0>;
			renesas,#ch = <0>;
			renesas,#fcp_ch = <0>;
		};

		fcpvd: fcp@16470000 {
			compatible = "renesas,r9a09g057-fcpvd",
				     "renesas,fcpv";
			reg = <0 0x10880000 0 0x10000>;
			clocks = <&cpg CPG_MOD 0xed>,
				 <&cpg CPG_MOD 0xee>,
				 <&cpg CPG_MOD 0xef>;
			clock-names = "aclk", "pclk", "vclk";
			resets = <&cpg 0xdc>;
			power-domains = <&cpg>;
		};

		vspd: vsp@16480000 {
			compatible = "renesas,r9a07g044-vsp2";
			reg = <0 0x16480000 0 0x10000>;
			interrupts = <GIC_SPI 881 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD 0xed>,
				 <&cpg CPG_MOD 0xee>,
				 <&cpg CPG_MOD 0xef>;
			clock-names = "aclk", "pclk", "vclk";
			resets = <&cpg 0xdc>;
			power-domains = <&cpg>;
			renesas,fcp = <&fcpvd>;
		};

		usb3_phy0: usb-phy@15870000 {
			compatible = "renesas,usb3-phy-r9a09g057",
					"renesas,rz-usb3-phy";
			reg = <0 0x15870000 0 0x10000>;
			clocks = <&cpg CPG_MOD 0xb0>;
			power-domains = <&cpg>;
			resets = <&cpg 0xaa>;
			#phy-cells = <0>;
			status = "disabled";
		};

		usb3_phy1: usb-phy@15880000 {
			compatible = "renesas,usb3-phy-r9a09g057",
					"renesas,rz-usb3-phy";
			reg = <0 0x15880000 0 0x10000>;
			clocks = <&cpg CPG_MOD 0xb2>;
			power-domains = <&cpg>;
			resets = <&cpg 0xab>;
			#phy-cells = <0>;
			status = "disabled";
		};

		xhci0: usb@15850000 {
			compatible = "renesas,rzv2h-xhci";
			reg = <0 0x15850000 0 0x10000>;
			interrupts = <GIC_SPI 759 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD 0xaf>;
			clock-names = "reg";
			power-domains = <&cpg>;
			resets = <&cpg 0xaa>;
			phys = <&usb3_phy0>;
			phy-names = "usb0";
			status = "disabled";
		};

		xhci1: usb@15860000 {
			compatible = "renesas,rzv2h-xhci";
			reg = <0 0x15860000 0 0x10000>;
			interrupts = <GIC_SPI 764 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD 0xb1>;
			clock-names = "reg";
			power-domains = <&cpg>;
			resets = <&cpg 0xab>;
			phys = <&usb3_phy1>;
			phy-names = "usb1";
			status = "disabled";
		};

		eth0: ethernet@15c30000 {
			compatible = "renesas,r9a09g057-gbeth", "renesas,rzv2h-gbeth",
				     "snps,dwmac-5.20";
			reg = <0 0x15c30000 0 0x10000>;
			interrupts = <GIC_SPI 765 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 767 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 766 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 772 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 773 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 774 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 775 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 768 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 769 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 770 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 771 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_wake_irq", "eth_lpi",
					  "rx-queue-0", "rx-queue-1", "rx-queue-2",
					  "rx-queue-3", "tx-queue-0", "tx-queue-1",
					  "tx-queue-2", "tx-queue-3";
			clocks =  <&cpg CPG_MOD 0xbd>, <&cpg CPG_MOD 0xbc>,
				  <&cpg CPG_CORE R9A09G057_GBETH_0_CLK_PTP_REF_I>,
				  <&cpg CPG_MOD 0xb8>, <&cpg CPG_MOD 0xb9>,
				  <&cpg CPG_MOD 0xba>, <&cpg CPG_MOD 0xbb>;
			clock-names = "stmmaceth", "pclk", "ptp_ref",
				      "tx", "rx", "tx-180", "rx-180";
			resets = <&cpg 0xb0>;
			power-domains = <&cpg>;
			renesas,eth-syscon = <&sys 0>;
			snps,multicast-filter-bins = <256>;
			snps,perfect-filter-entries = <128>;
			rx-fifo-depth = <8192>;
			tx-fifo-depth = <8192>;
			snps,fixed-burst;
			snps,no-pbl-x8;
			snps,force_thresh_dma_mode;
			snps,axi-config = <&stmmac_axi_setup>;
			snps,mtl-rx-config = <&mtl_rx_setup0>;
			snps,mtl-tx-config = <&mtl_tx_setup0>;
			snps,txpbl = <32>;
			snps,rxpbl = <32>;
			status = "disabled";

			mdio0: mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			mtl_rx_setup0: rx-queues-config {
				snps,rx-queues-to-use = <4>;
				snps,rx-sched-sp;

				queue0 {
					snps,dcb-algorithm;
					snps,priority = <0x1>;
					snps,map-to-dma-channel = <0>;
				};

				queue1 {
					snps,dcb-algorithm;
					snps,priority = <0x2>;
					snps,map-to-dma-channel = <1>;
				};

				queue2 {
					snps,dcb-algorithm;
					snps,priority = <0x4>;
					snps,map-to-dma-channel = <2>;
				};

				queue3 {
					snps,dcb-algorithm;
					snps,priority = <0x8>;
					snps,map-to-dma-channel = <3>;
				};
			};

			mtl_tx_setup0: tx-queues-config {
				snps,tx-queues-to-use = <4>;

				queue0 {
					snps,dcb-algorithm;
					snps,priority = <0x1>;
				};

				queue1 {
					snps,dcb-algorithm;
					snps,priority = <0x2>;
				};

				queue2 {
					snps,dcb-algorithm;
					snps,priority = <0x4>;
				};

				queue3 {
					snps,dcb-algorithm;
					snps,priority = <0x8>;
				};
			};
		};

		eth1: ethernet@15c40000 {
			compatible = "renesas,r9a09g057-gbeth", "renesas,rzv2h-gbeth",
				     "snps,dwmac-5.20";
			reg = <0 0x15c40000 0 0x10000>;
			interrupts = <GIC_SPI 780 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 782 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 781 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 787 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 788 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 789 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 790 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 783 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 784 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 785 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 786 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_wake_irq", "eth_lpi",
					  "rx-queue-0", "rx-queue-1", "rx-queue-2",
					  "rx-queue-3", "tx-queue-0", "tx-queue-1",
					  "tx-queue-2", "tx-queue-3";
			clocks =  <&cpg CPG_MOD 0xc3>, <&cpg CPG_MOD 0xc2>,
				  <&cpg CPG_CORE R9A09G057_GBETH_1_CLK_PTP_REF_I>,
				  <&cpg CPG_MOD 0xbe>, <&cpg CPG_MOD 0xbf>,
				  <&cpg CPG_MOD 0xc0>, <&cpg CPG_MOD 0xc1>;
			clock-names = "stmmaceth", "pclk", "ptp_ref",
				      "tx", "rx", "tx-180", "rx-180";
			resets = <&cpg 0xb1>;
			power-domains = <&cpg>;
			renesas,eth-syscon = <&sys 1>;
			snps,multicast-filter-bins = <256>;
			snps,perfect-filter-entries = <128>;
			rx-fifo-depth = <8192>;
			tx-fifo-depth = <8192>;
			snps,fixed-burst;
			snps,no-pbl-x8;
			snps,force_thresh_dma_mode;
			snps,axi-config = <&stmmac_axi_setup>;
			snps,mtl-rx-config = <&mtl_rx_setup1>;
			snps,mtl-tx-config = <&mtl_tx_setup1>;
			snps,txpbl = <32>;
			snps,rxpbl = <32>;
			status = "disabled";

			mdio1: mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			mtl_rx_setup1: rx-queues-config {
				snps,rx-queues-to-use = <4>;
				snps,rx-sched-sp;

				queue0 {
					snps,dcb-algorithm;
					snps,priority = <0x1>;
					snps,map-to-dma-channel = <0>;
				};

				queue1 {
					snps,dcb-algorithm;
					snps,priority = <0x2>;
					snps,map-to-dma-channel = <1>;
				};

				queue2 {
					snps,dcb-algorithm;
					snps,priority = <0x4>;
					snps,map-to-dma-channel = <2>;
				};

				queue3 {
					snps,dcb-algorithm;
					snps,priority = <0x8>;
					snps,map-to-dma-channel = <3>;
				};
			};

			mtl_tx_setup1: tx-queues-config {
				snps,tx-queues-to-use = <4>;

				queue0 {
					snps,dcb-algorithm;
					snps,priority = <0x1>;
				};

				queue1 {
					snps,dcb-algorithm;
					snps,priority = <0x2>;
				};

				queue2 {
					snps,dcb-algorithm;
					snps,priority = <0x4>;
				};

				queue3 {
					snps,dcb-algorithm;
					snps,priority = <0x8>;
				};
			};
		};

		isu: isum@16450000 {
			compatible = "renesas,isum";
			reg = <0 0x16450000 0 0x01F4>;
			interrupts = <GIC_SPI 867 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 868 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 869 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 870 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 871 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 872 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 873 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD 0xe6>, <&cpg CPG_MOD 0xe7>;
			clock-names = "isu_aclk", "isu_pclk";
			resets = <&cpg 0xd5>, <&cpg 0xd6>;
			reset-names = "aresetn", "presetn";
			renesas,#ch = <0>;
			renesas,#rpf = <1>;
			renesas,#wpf = <1>;
			renesas,has-rs;
			power-domains = <&cpg>;
		};

		rcar_sound: sound@13c00000 {
			/*
			 * #sound-dai-cells is required
			 *
			 * Single DAI : #sound-dai-cells = <0>; <&rcar_sound>;
			 * Multi  DAI : #sound-dai-cells = <1>; <&rcar_sound N>;
			 */
			/*
			 * #clock-cells is required for audio_clkout0/1/2/3
			 *
			 * clkout       : #clock-cells = <0>;   <&rcar_sound>;
			 * clkout0/1/2/3: #clock-cells = <1>;   <&rcar_sound N>;
			 */
			compatible =  "renesas,rcar_sound-r9a09g057";
			reg =   <0 0x13c00000 0 0x10000>, /* SCU */
				<0 0x13c20000 0 0x10000>, /* ADG */
				<0 0x13c30000 0 0x1000>,  /* SSIU */
				<0 0x13c31000 0 0x1F000>, /* SSI */
				<0 0x13c50000 0 0x10000>; /* Audio DMAC peri peri */
			reg-names = "scu", "adg", "ssiu", "ssi", "audmapp";
			clocks = <&cpg CPG_MOD 0xf5>,
				 <&cpg CPG_MOD 0x18a>,
				 <&cpg CPG_MOD 0x189>,
				 <&cpg CPG_MOD 0x188>,
				 <&cpg CPG_MOD 0x187>,
				 <&cpg CPG_MOD 0x186>,
				 <&cpg CPG_MOD 0x185>,
				 <&cpg CPG_MOD 0x184>,
				 <&cpg CPG_MOD 0x183>,
				 <&cpg CPG_MOD 0x182>,
				 <&cpg CPG_MOD 0x181>,
				 <&cpg CPG_MOD 0x180>,
				 <&cpg CPG_MOD 0xf6>,
				 <&cpg CPG_MOD 0xf7>,
				 <&cpg CPG_MOD 0x17d>,
				 <&cpg CPG_MOD 0x17c>,
				 <&cpg CPG_MOD 0x17b>,
				 <&cpg CPG_MOD 0x17a>,
				 <&cpg CPG_MOD 0x179>,
				 <&cpg CPG_MOD 0x178>,
				 <&cpg CPG_MOD 0x177>,
				 <&cpg CPG_MOD 0x176>,
				 <&cpg CPG_MOD 0x175>,
				 <&cpg CPG_MOD 0x174>,
				 <&cpg CPG_MOD 0x17e>,
				 <&cpg CPG_MOD 0x173>,
				 <&cpg CPG_MOD 0x172>,
				 <&cpg CPG_MOD 0x173>,
				 <&cpg CPG_MOD 0x172>,
				 <&cpg CPG_MOD 0x170>,
				 <&cpg CPG_MOD 0x171>,
				 <&cpg CPG_MOD 0xf8>,
				 <&cpg CPG_MOD 0xf9>,
				 <&cpg CPG_MOD 0xfb>,
				 <&cpg CPG_MOD 0xfc>,
				 <&cpg CPG_MOD 0xfd>,
				 <&cpg CPG_MOD 0xfa>,
				 <&cpg CPG_MOD 0x169>,
				 <&cpg CPG_MOD 0x168>,
				 <&cpg CPG_MOD 0x167>,
				 <&cpg CPG_MOD 0x166>,
				 <&cpg CPG_MOD 0x165>,
				 <&cpg CPG_MOD 0x164>,
				 <&cpg CPG_MOD 0x163>,
				 <&cpg CPG_MOD 0x162>,
				 <&cpg CPG_MOD 0x161>,
				 <&cpg CPG_MOD 0x160>;
			clock-names = "ssi-all",
				 "ssi.9", "ssi.8", "ssi.7", "ssi.6",
				 "ssi.5", "ssi.4", "ssi.3", "ssi.2",
				 "ssi.1", "ssi.0",
				 "ssif_supply_clk",
				 "scu_clk", "scu_clkx2",
				 "src.9", "src.8", "src.7", "src.6",
				 "src.5", "src.4", "src.3", "src.2",
				 "src.1", "src.0",
				 "scu_supply_clk",
				 "mix.1", "mix.0",
				 "ctu.1", "ctu.0",
				 "dvc.0", "dvc.1",
				 "audmac-pp",
				 "adg_clk",
				 "clk_a", "clk_b", "clk_c", "clk_i",
				 "adg.ssi.9", "adg.ssi.8", "adg.ssi.7", "adg.ssi.6",
				 "adg.ssi.5", "adg.ssi.4", "adg.ssi.3", "adg.ssi.2",
				 "adg.ssi.1", "adg.ssi.0";
			power-domains = <&cpg>;
			resets = <&cpg 0xe1>, <&cpg 0xeb>, <&cpg 0xea>,
				 <&cpg 0xe9>, <&cpg 0xe8>, <&cpg 0xe7>,
				 <&cpg 0xe6>, <&cpg 0xe5>, <&cpg 0xe4>,
				 <&cpg 0xe3>, <&cpg 0xe2>, <&cpg 0xed>,
				 <&cpg 0xec>, <&cpg 0xee>;
			reset-names = "ssi-all",
				 "ssi.9", "ssi.8", "ssi.7", "ssi.6",
				 "ssi.5", "ssi.4", "ssi.3", "ssi.2",
				 "ssi.1", "ssi.0",
				 "audmac-pp", "scu",
				 "adg";
			status = "disabled";

			rcar_sound,ctu {
				ctu00: ctu-0 { };
				ctu01: ctu-1 { };
				ctu02: ctu-2 { };
				ctu03: ctu-3 { };
				ctu10: ctu-4 { };
				ctu11: ctu-5 { };
				ctu12: ctu-6 { };
				ctu13: ctu-7 { };
			};

			rcar_sound,dvc {
				dvc0: dvc-0 {
					dmas = <&dmac1 0x1A1DB3>;
					dma-names = "tx";
				};
				dvc1: dvc-1 {
					dmas = <&dmac1 0x1B1DB4>;
					dma-names = "tx";
				};
			};

			rcar_sound,mix {
				mix0: mix-0 { };
				mix1: mix-1 { };
			};

			rcar_sound,src {
				src0: src-0 {
					interrupts = <GIC_SPI 902 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x061D9F>, <&dmac2 0x101DA9>;
					dma-names = "rx", "tx";
				};
				src1: src-1 {
					interrupts = <GIC_SPI 903 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x071DA0>, <&dmac2 0x111DAA>;
					dma-names = "rx", "tx";
				};
				src2: src-2 {
					interrupts = <GIC_SPI 904 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x081DA1>, <&dmac2 0x121DAB>;
					dma-names = "rx", "tx";
				};
				src3: src-3 {
					interrupts = <GIC_SPI 905 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x091DA2>, <&dmac2 0x131DAC>;
					dma-names = "rx", "tx";
				};
				src4: src-4 {
					interrupts = <GIC_SPI 906 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x0A1DA3>, <&dmac2 0x141DAD>;
					dma-names = "rx", "tx";
				};
				src5: src-5 {
					interrupts = <GIC_SPI 907 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x0B1DA4>, <&dmac2 0x151DAE>;
					dma-names = "rx", "tx";
				};
				src6: src-6 {
					interrupts = <GIC_SPI 908 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x0C1DA5>, <&dmac2 0x161DAF>;
					dma-names = "rx", "tx";
				};
				src7: src-7 {
					interrupts = <GIC_SPI 909 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x0D1DA6>, <&dmac2 0x171DB0>;
					dma-names = "rx", "tx";
				};
				src8: src-8 {
					interrupts = <GIC_SPI 910 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x0E1DA7>, <&dmac2 0x181DB1>;
					dma-names = "rx", "tx";
				};
				src9: src-9 {
					interrupts = <GIC_SPI 911 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&dmac1 0x0F1DA8>, <&dmac2 0x191DB2>;
					dma-names = "rx", "tx";
				};
			};

			rcar_sound,ssi {
				ssi0: ssi-0 {
					interrupts = <GIC_SPI 889 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi1: ssi-1 {
					interrupts = <GIC_SPI 890 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi2: ssi-2 {
					interrupts = <GIC_SPI 891 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi3: ssi-3 {
					interrupts = <GIC_SPI 892 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi4: ssi-4 {
					interrupts = <GIC_SPI 893 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi5: ssi-5 {
					interrupts = <GIC_SPI 894 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi6: ssi-6 {
					interrupts = <GIC_SPI 895 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi7: ssi-7 {
					interrupts = <GIC_SPI 896 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi8: ssi-8 {
					interrupts = <GIC_SPI 897 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi9: ssi-9 {
					interrupts = <GIC_SPI 898 IRQ_TYPE_LEVEL_HIGH>;
				};
			};

			rcar_sound,ssiu {
				ssiu00: ssiu-0 {
					dmas = <&dmac1 0x1C1D61>, <&dmac2 0x1D1D62>;
					dma-names = "tx", "rx";
