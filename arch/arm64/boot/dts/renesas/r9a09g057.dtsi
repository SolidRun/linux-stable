			clock-names = "fck", "ram_clk", "can_clk";
			resets = <&cpg 0xa1>, <&cpg 0xa2>;
			reset-names = "rstp_n", "rstc_n";
			power-domains = <&cpg>;
			status = "disabled";

			channel0 {
			        status = "disabled";
			};
			channel1 {
			        status = "disabled";
			};
			channel2 {
			        status = "disabled";
			};
			channel3 {
			        status = "disabled";
