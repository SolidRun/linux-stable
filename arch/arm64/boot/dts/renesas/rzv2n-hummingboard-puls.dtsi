#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <dt-bindings/leds/common.h>

/ {
	aliases {
		rtc0 = &carrier_rtc;
		rtc1 = &pmic_rtc;
	};

	v_1_2: regulator-1-2 {
		compatible = "regulator-fixed";
		regulator-name = "1v2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
	};

	v_1_8: regulator-1-8 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	v_3_3: regulator-3-3 {
		compatible = "regulator-fixed";
		regulator-name = "3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vmmc: regulator-mmc {
		compatible = "regulator-fixed";
		regulator-name = "vmmc";
		vin-supply = <&v_3_3>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&pinctrl RZG2L_GPIO(10, 3) GPIO_ACTIVE_LOW>;
		enable-active-high;
		gpio-open-drain;
		regulator-always-on;
	};

	vmpcie: regulator-mpcie-3-3 {
		/* supplies mpcie and m2 connectors */
		compatible = "regulator-fixed";
		regulator-name = "vmpcie";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pinctrl RZG2L_GPIO(6, 4) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	reg_usb1_host_vbus: regulator-usb1-host-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1_host_vbus";
		pinctrl-names = "default";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		//gpio = <&pinctrl RZG2L_GPIO(x, x) GPIO_ACTIVE_HIGH>; /* Not Connected J9[37] */
		regulator-always-on;
		enable-active-high;
	};

	reg_usb1_vbus: regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1_vbus";
		pinctrl-names = "default";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pinctrl RZG2L_GPIO(9, 5) GPIO_ACTIVE_HIGH>;
		gpio-open-drain;
		regulator-always-on;
		enable-active-high;
	};

	pwr-mpcie {
		compatible = "regulator-output";
		vout-supply = <&vmpcie>;
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "D30";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pinctrl RZG2L_GPIO(3, 5) GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-1 {
			label = "D31";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pinctrl RZG2L_GPIO(7, 3) GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-2 {
			label = "D32";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pinctrl RZG2L_GPIO(7, 2) GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-3 {
			label = "D33";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pinctrl RZG2L_GPIO(7, 1) GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-4 {
			label = "D34";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pinctrl RZG2L_GPIO(7, 0) GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "d";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&adv7535_out>;
			};
		};
	};

	rfkill-mpcie-wifi {
		/*
		 * The mpcie connector only has USB,
		 * therefore this rfkill is for cellular radios only.
		 */
		compatible = "rfkill-gpio";
		label = "mpcie radio";
		radio-type = "wwan";
		/* rfkill-gpio inverts internally */
		shutdown-gpios = <&pinctrl RZG2L_GPIO(7, 5) GPIO_ACTIVE_HIGH>;
	};

	 gpio-keys {
		compatible = "gpio-keys";

		wakeup-event {
			label = "m2-wakeup";
			interrupts-extended = <&pinctrl RZG2L_GPIO(0, 0) IRQ_TYPE_EDGE_FALLING>;
			linux,code = <KEY_WAKEUP>;
			wakeup-source;
		};
	};

	rfkill-m2-gnss {
		compatible = "rfkill-gpio";
		label = "m.2 GNSS";
		radio-type = "gps";
		/* rfkill-gpio inverts internally */
		shutdown-gpios = <&pinctrl RZG2L_GPIO(0, 3) GPIO_ACTIVE_HIGH>;
	};

	/* M.2 is B-keyed, so w-disable is for WWAN */
	rfkill-m2-wwan {
		compatible = "rfkill-gpio";
		label = "m.2 WWAN";
		radio-type = "wwan";
		/* rfkill-gpio inverts internally */
		shutdown-gpios = <&pinctrl RZG2L_GPIO(7, 4) GPIO_ACTIVE_HIGH>;
	};
};

&sdhi1 {
	cd-gpios = <&pinctrl RZG2L_GPIO(9, 4) GPIO_ACTIVE_LOW>;
};

&xhci0 {
	status = "okay";
};

&eth0 {
	status = "okay";
};

&eth1 {
	/* this board does not use second phy / ethernet on SoM */
	status = "disabled";
};

&hsusb {
	status = "okay";
};

&ohci0 {
	spurious-oc;
	dr_mode = "otg";
	status = "okay";
};

&usb2_phy0 {
	dr_mode = "host";
	status = "okay";
};

&usb3_phy0 {
	dr_mode = "host";
	status = "okay";
};

/* mikrobus uart (uart2) */
&sci2 {
	status = "okay";
};

/* mikrobus spi */
&rspi0 {
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins_no_ss>;
	cs-gpios = <&pinctrl RZG2L_GPIO(9, 3) GPIO_ACTIVE_LOW>;
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";

	carrier_eeprom: eeprom@57 {
		compatible = "st,24c02", "atmel,24c02";
		reg = <0x57>;
		pagesize = <16>;
	};

	carrier_rtc: rtc@69 {
		compatible = "abracon,ab1805";
		reg = <0x69>;
		abracon,tc-diode = "schottky";
		abracon,tc-resistor = <3>;
	};

	adv7535: hdmi@3d {
		compatible = "adi,adv7535";
		status = "okay";
		reg = <0x3d>, <0x3f>, <0x3c>, <0x38>;
		reg-names = "main", "edid", "cec", "packet";
		adi,dsi-lanes = <4>;
		avdd-supply = <&v_1_8>;
		dvdd-supply = <&v_1_8>;
		pvdd-supply = <&v_1_8>;
		a2vdd-supply = <&v_1_8>;
		v3p3-supply = <&v_3_3>;

		pd-gpios = <&pinctrl RZG2L_GPIO(3, 1) GPIO_ACTIVE_LOW>;
		interrupts-extended = <&pinctrl RZG2L_GPIO(7, 6) IRQ_TYPE_EDGE_FALLING>;
		interrupt-parent = <&pinctrl>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				adv7535_in: endpoint {
					remote-endpoint = <&dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				adv7535_out: endpoint {
					remote-endpoint = <&hdmi_connector_in>;
				};
			};
		};
	};
};

&du {
	status = "okay";
};

&dsi0 {
	status = "okay";

	ports {
		port@1 {
			dsi0_out: endpoint {
				remote-endpoint = <&adv7535_in>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&phy0 {
	leds {
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_LAN;
			default-state = "keep";
		};

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			default-state = "keep";
		};
	};
};

&pinctrl {
	pinctrl-names = "default";

	mpcie_rst_hog: mpcie-reset-hog {
		gpio-hog;
		gpios = <RZG2L_GPIO(6, 0) GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "mpcie-reset";
	};

	m2-reset-hog {
		gpio-hog;
		gpios = <RZG2L_GPIO(0, 1) GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "m2-reset";
	};

	/*
	 * USB hub is disabled due to I/O voltage level incompatibility.
	 * The SoM provides 1.8V I/O levels on these GPIO pins, but the
	 * USB hub requires 3.3V I/O signaling. This voltage mismatch
	 * prevents proper communication with the hub IC.
	 * Keep hub in reset and power disabled to avoid potential issues.
	 */
	usb-hub-reset-hog {
		gpio-hog;
		gpios = <RZG2L_GPIO(8, 4) GPIO_ACTIVE_HIGH>;
		output-low;  /* Assert reset (active-high) to disable hub */
		line-name = "usb-hub-reset";
	};

	usb-hub-enable-hog {
		gpio-hog;
		gpios = <RZG2L_GPIO(4, 6) GPIO_ACTIVE_HIGH>;
		output-low;  /* Keep power disabled (active-high) */
		line-name = "usb-hub-enable";
	};

	spi0_pins_no_ss: spi0 {
			pinmux = <RZG2L_PORT_PINMUX(9, 0, 1)>, /* MOSIA */
			<RZG2L_PORT_PINMUX(9, 1, 1)>, /* MISOA */
			<RZG2L_PORT_PINMUX(9, 2, 1)>; /* RSPCK */
	};
};
