 * Copyright 2025 Josua Mayer <josua@solid-run.com>
 *
 * Overlay for Basler camera attached to HummingBoard Pulse camera connector.
 */

/dts-v1/;
/plugin/;

&i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;

	camera@36 {
		compatible = "basler,basler-camera-vvcam", "basler-camera-vvcam";
		reg = <0x36>;
		csi_id = <0x00>;

		port {
			camera_to_csi0: endpoint {
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
				link-frequencies = /bits/ 64 <750000000>;
				max-lane-frequency = /bits/ 64 <750000000>;
				max-pixel-frequency = /bits/ 64 <266000000>;
				max-data-rate = /bits/ 64 <0>;
				remote-endpoint = <&csi0_from_camera>;
			};
		};
	};
};

&isi_0 {
	status = "okay";
};

&isp_0 {
	status = "okay";
};

&mipi_csi_0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			csi0_from_camera: endpoint {
				remote-endpoint = <&camera_to_csi0>;
				data-lanes = <4>;
				csis-hs-settle = <16>;
			};
		};
	};
};
